[Unit]
Description=银龄智伴 AI 陪护平台
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 部署前把下面两处替换为实际的 Linux 用户和项目目录。
User=__SSH_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/yinlingzhban/yinlingzhban.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 __APP_DIR__/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
